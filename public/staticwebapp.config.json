{
  "routes": [
    {
      "route": "/mingyu-runtime-config.js",
      "rewrite": "/api/mingyu-runtime-config.js"
    },
    {
      "route": "/.well-known/aov-mingyu-api.json",
      "rewrite": "/api/.well-known/aov-mingyu-api.json"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/skills/*",
      "/.well-known/*",
      "/mingyu-runtime-config.js",
      "*.{png,jpg,jpeg,svg,ico,webmanifest,js,css,json,txt,xml}"
    ]
  }
}
